---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---
<BaseLayout title="Experience - Daksh Verma" description="Professional experience, education, and achievements timeline" currentPath="/experience">

<div class="page-header"><div class="container">
  <p class="section-label">Journey</p>
  <h1 class="page-title">Experience & Education</h1>
  <p class="page-desc">A timeline of internships, education, leadership, and major achievements.</p>
</div></div>

<section class="section" style="padding-top:20px;">
<div class="container">
  <div class="timeline">
    <div class="timeline-item reveal">
      <div class="timeline-dot"></div>
      <div class="timeline-date">May 2026 - Jul 2026</div>
      <h3 class="timeline-title">💼 Software Development Engineer Intern</h3>
      <p class="timeline-org">🟦 Microsoft India | Hyderabad</p>
      <p class="timeline-desc">SDE Internship at Microsoft India (Scheduled start: May 25, 2026).</p>
      <div class="timeline-tags"><span class="tag">Microsoft</span><span class="tag">SDE</span></div>
    </div>

    <div class="timeline-item reveal">
      <div class="timeline-dot"></div>
      <div class="timeline-date">Apr 2026</div>
      <h3 class="timeline-title">🏆 AIR 65 - Coding Premier League</h3>
      <p class="timeline-org">NxtWave Launchpad</p>
      <p class="timeline-desc">All India Rank 65 in national DSA competition spanning IITs, NITs, IIITs, and BITS. Ranked 1st in batch and 2nd across NIT Delhi campus.</p>
      <div class="timeline-tags"><span class="tag">DSA</span><span class="tag">Competitive Programming</span></div>
    </div>

    <div class="timeline-item reveal">
      <div class="timeline-dot"></div>
      <div class="timeline-date">Mar 2026</div>
      <h3 class="timeline-title">🤖 FinVault - Agentic Finance Manager</h3>
      <p class="timeline-org">Full-Stack AI Project</p>
      <p class="timeline-desc">Built privacy-first mobile finance platform with OCR receipt parsing, Gemini AI categorization, and ONDC architecture roadmap.</p>
    </div>

    <div class="timeline-item reveal">
      <div class="timeline-dot"></div>
      <div class="timeline-date">Feb 2026</div>
      <h3 class="timeline-title">📊 2nd Runner-Up - Impact-Metrics Championship</h3>
      <p class="timeline-org">IIT (BHU) Varanasi | Jagriti 2026</p>
      <p class="timeline-desc">3rd place nationally in data analytics championship. Built end-to-end environmental data analysis pipeline with interactive pollution monitoring dashboard. Presented defense to expert panel.</p>
    </div>

    <div class="timeline-item reveal">
      <div class="timeline-dot"></div>
      <div class="timeline-date">Sep 2025</div>
      <h3 class="timeline-title">🛡️ AML Neural Pipeline</h3>
      <p class="timeline-org">National CyberShield Hackathon | MANIT Bhopal</p>
      <p class="timeline-desc">Built dual-phase Graph Attention Network system for anti-money laundering detection. 98.91% accuracy on 56K+ transactions with 77K+ graph nodes.</p>
    </div>

    <div class="timeline-item reveal">
      <div class="timeline-dot"></div>
      <div class="timeline-date">Jun - Jul 2025</div>
      <h3 class="timeline-title">💻 Software Engineering Intern</h3>
      <p class="timeline-org">C-DAC Noida | Centre for Development of Advanced Computing</p>
      <p class="timeline-desc">Built ChatZero real-time messaging system with Spring Boot, Spring Security, and an in-memory STOMP broker. Developed public service chatbot assistants integrated into e-Aushadhi and e-Upkaran national healthcare platforms via keyword-matching rule engines.</p>
      <div class="timeline-tags"><span class="tag">Java</span><span class="tag">Spring Boot</span><span class="tag">WebSockets</span></div>
    </div>

    <div class="timeline-item reveal">
      <div class="timeline-dot"></div>
      <div class="timeline-date">Apr 2025</div>
      <h3 class="timeline-title">🥇 AIR 1 - Engineers' Ring of Honour</h3>
      <p class="timeline-org">Naukri Campus | Featured in Times of India</p>
      <p class="timeline-desc">Secured All India Rank 1 nationally. Featured on Page 7 of The Times of India. Awarded full-semester academic scholarship, custom blazer, and national distinction. Designed AI-driven logistics optimization strategy projecting 30% delivery time reduction.</p>
      <div class="timeline-tags"><span class="tag">National Rank 1</span><span class="tag">Full Scholarship</span></div>
    </div>

    <div class="timeline-item reveal">
      <div class="timeline-dot"></div>
      <div class="timeline-date">Aug 2024</div>
      <h3 class="timeline-title">🔒 Certificate of Merit - Great AppSec Hackathon</h3>
      <p class="timeline-org">DSCI | Cybersecurity Centre of Excellence</p>
      <p class="timeline-desc">Qualified through national cybersecurity quiz and Capture The Flag (CTF) rounds. Demonstrated expertise in cloud security, network architecture, and application security.</p>
    </div>

    <div class="timeline-item reveal">
      <div class="timeline-dot"></div>
      <div class="timeline-date">Jul - Aug 2024</div>
      <h3 class="timeline-title">🚁 Team Lead - NITro Dynamics FPV Racing Drone</h3>
      <p class="timeline-org">Technoxian World Robotics Championship 2024</p>
      <p class="timeline-desc">Led 9-member engineering team. Managed INR 48K+ hardware budget. Built high-velocity FPV racing drone with Hobbywing XRotor F7 flight controller and Emax brushless motors. Cleared all technical inspections.</p>
    </div>

    <div class="timeline-item reveal">
      <div class="timeline-dot"></div>
      <div class="timeline-date">2023 - 2027</div>
      <h3 class="timeline-title">🎓 B.Tech Computer Science & Engineering</h3>
      <p class="timeline-org">National Institute of Technology Delhi</p>
      <p class="timeline-desc">CGPA: 8.7/10.0 | Expected graduation: May 2027</p>
      <div class="timeline-tags"><span class="tag">CSE</span><span class="tag">NIT Delhi</span></div>
    </div>

    <div class="timeline-item reveal">
      <div class="timeline-dot"></div>
      <div class="timeline-date">2011 - 2023</div>
      <h3 class="timeline-title">🏫 Sanskriti School, New Delhi</h3>
      <p class="timeline-org">CBSE Class 12: 95.8% | Class 10: 95.83%</p>
      <p class="timeline-desc">AWES Scholar (2019-2023). Multiple national competition wins: KAMP-NASTA 2nd National Rank, Budding Ramanujan 4th National Rank, CSMC Distinction, TCS IT Wiz Top 100.</p>
    </div>
  </div>
</div>
</section>

</BaseLayout>
