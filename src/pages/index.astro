<script>
// ===== TERMINAL ANIMATION =====
function initTerminal() {
  const body = document.getElementById('terminal-body');
  if (!body) return;
  const autoLines = [
    { type: 'prompt', text: 'whoami' },
    { type: 'name', text: 'Daksh Verma' },
    { type: 'role', text: 'Software Engineer' },
    { type: 'blank' },
    { type: 'tags', items: ['Backend Systems', 'Distributed Systems', 'Infrastructure', 'AI Engineering'] },
    { type: 'blank' },
    { type: 'hint', text: 'Hint: Type "help" for commands, or "play" to defend the cache...' },
  ];
  
  const commands = {
    help: 'Available commands: whoami, skills, projects, contact, resume, ls, clear\n[Hidden]: play',
    whoami: 'I am Daksh Verma, a backend engineer and AI pipeline builder currently studying at NIT Delhi.\nWhen I\'m not architecting distributed systems or building agentic frameworks, you\'ll probably find me at the gym, riding my bike, swimming, or gaming.\nI thrive on building tools that solve complex, high-scale problems.',
    skills: 'Languages: Java, Python, C/C++, JavaScript, SQL\nBackend: Spring Boot, FastAPI, Node.js, WebSockets\nAI/ML: PyTorch, TensorFlow, GAT, LLM Fine-tuning\nInfra: AWS, Docker, Neo4j, MongoDB, MySQL',
    projects: 'Featured: AML Neural Pipeline, ChatZero, FinVault, ET Markets AI\nType: /projects to visit the projects page',
    contact: 'Email: verma11daksh@gmail.com\nGitHub: github.com/DakshVerma11\nLinkedIn: linkedin.com/in/verma11daksh',
    resume: 'Opening resume page...',
    play: 'Launching Database Cache Defender...',
    clear: '__CLEAR__',
    ls: 'projects/  experience/  achievements/  resume.pdf  src/  docker-compose.yml'
  };

  function renderLine(line, delay) {
    const style = `animation-delay:${delay}s`;
    if (line.type === 'prompt') return `<div class="terminal-line" style="${style}"><span class="terminal-prompt">❯ </span><span class="terminal-cmd">${line.text}</span></div>`;
    if (line.type === 'name') return `<div class="terminal-line" style="${style}"><span class="terminal-name">${line.text}</span></div>`;
    if (line.type === 'role') return `<div class="terminal-line" style="${style}"><span class="terminal-role">${line.text}</span></div>`;
    if (line.type === 'blank') return `<div class="terminal-line" style="${style}">&nbsp;</div>`;
    if (line.type === 'tags') return `<div class="terminal-line" style="${style}">${line.items.map(t => `<span class="terminal-tag">${t}</span>`).join('')}</div>`;
    if (line.type === 'output') return `<div class="terminal-line" style="${style}"><span class="terminal-output">${line.text}</span></div>`;
    if (line.type === 'hint') return `<div class="terminal-line" style="${style}"><span class="terminal-output" style="color:var(--text-muted);">${line.text}</span></div>`;
    return '';
  }

  // Render auto lines
  let html = '<div class="terminal-history">';
  autoLines.forEach((line, i) => { html += renderLine(line, i * 0.18 + 0.3); });
  html += '</div>';
  
  // Add interactive input
  const totalDelay = autoLines.length * 0.18 + 0.5;
  html += `<div class="terminal-line terminal-input-line" style="animation-delay:${totalDelay}s"><span class="terminal-prompt">❯ </span><input class="terminal-input" id="term-input" type="text" placeholder="type help..." autocomplete="off" spellcheck="false" /></div>`;
  body.innerHTML = html;
  
  const input = document.getElementById('term-input');
  const history = body.querySelector('.terminal-history');
  if (!input || !history) return;
  
  input.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    const cmd = input.value.trim().toLowerCase();
    input.value = '';
    if (!cmd) return;
    
    // Add command to history
    history.insertAdjacentHTML('beforeend', `<div class="terminal-line" style="animation-delay:0s"><span class="terminal-prompt">❯ </span><span class="terminal-cmd">${cmd}</span></div>`);
    
    if (commands[cmd]) {
      if (cmd === 'clear') {
        history.innerHTML = '';
        return;
      }
      if (cmd === 'resume') {
        history.insertAdjacentHTML('beforeend', `<div class="terminal-line" style="animation-delay:0s"><span class="terminal-output">${commands[cmd]}</span></div>`);
        setTimeout(() => window.location.href = '/resume', 500);
        return;
      }
      if (cmd === 'play') {
        history.insertAdjacentHTML('beforeend', `<div class="terminal-line" style="animation-delay:0s"><span class="terminal-output">${commands[cmd]}</span></div>`);
        setTimeout(() => window.location.href = '/play', 500);
        return;
      }
      const lines = commands[cmd].split('\n');
      lines.forEach(l => {
        history.insertAdjacentHTML('beforeend', `<div class="terminal-line" style="animation-delay:0s"><span class="terminal-output">${l}</span></div>`);
      });
    } else {
      history.insertAdjacentHTML('beforeend', `<div class="terminal-line" style="animation-delay:0s"><span class="terminal-output" style="color:#ef4444;">command not found: ${cmd}</span></div>`);
    }
    history.scrollTop = history.scrollHeight;
  });
}

// ===== HERO PARTICLES =====
function initHeroCanvas() {
  const canvas = document.getElementById('hero-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  let w, h, particles = [], mouse = { x: -1000, y: -1000 };
  function resize() { w = canvas.width = canvas.offsetWidth; h = canvas.height = canvas.offsetHeight; }
  resize(); window.addEventListener('resize', resize);
  canvas.addEventListener('mousemove', e => { const r = canvas.getBoundingClientRect(); mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top; });
  canvas.addEventListener('mouseleave', () => { mouse.x = -1000; mouse.y = -1000; });
  const count = Math.min(80, Math.floor(w * h / 8000));
  for (let i = 0; i < count; i++) particles.push({ x: Math.random() * w, y: Math.random() * h, vx: (Math.random() - 0.5) * 0.3, vy: (Math.random() - 0.5) * 0.3, r: Math.random() * 1.5 + 0.5 });
  function draw() {
    ctx.clearRect(0, 0, w, h);
    for (let i = 0; i < particles.length; i++) {
      const p = particles[i];
      p.x += p.vx; p.y += p.vy;
      if (p.x < 0) p.x = w; if (p.x > w) p.x = 0; if (p.y < 0) p.y = h; if (p.y > h) p.y = 0;
      const dx = mouse.x - p.x, dy = mouse.y - p.y, dist = Math.sqrt(dx*dx + dy*dy);
      if (dist < 150) { p.x -= dx * 0.01; p.y -= dy * 0.01; }
      ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(59,130,246,${0.3 + p.r * 0.15})`; ctx.fill();
      for (let j = i + 1; j < particles.length; j++) {
        const p2 = particles[j], dx2 = p.x - p2.x, dy2 = p.y - p2.y, d = Math.sqrt(dx2*dx2 + dy2*dy2);
        if (d < 120) { ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(p2.x, p2.y); ctx.strokeStyle = `rgba(59,130,246,${0.08 * (1 - d / 120)})`; ctx.stroke(); }
      }
    }
    requestAnimationFrame(draw);
  }
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) draw();
}

// ===== INFRA VISUALIZATION =====
function initInfraCanvas() {
  const canvas = document.getElementById('infra-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  let w, h;
  function resize() { w = canvas.width = canvas.offsetWidth; h = canvas.height = canvas.offsetHeight; }
  resize(); window.addEventListener('resize', resize);
  const nodes = [
    { label: 'Client', x: 0.08, y: 0.5, color: '#3b82f6' },
    { label: 'Load Balancer', x: 0.22, y: 0.5, color: '#8b5cf6' },
    { label: 'API Gateway', x: 0.36, y: 0.3, color: '#06b6d4' },
    { label: 'Auth Service', x: 0.36, y: 0.7, color: '#06b6d4' },
    { label: 'Service A', x: 0.52, y: 0.25, color: '#3b82f6' },
    { label: 'Service B', x: 0.52, y: 0.55, color: '#3b82f6' },
    { label: 'Queue', x: 0.52, y: 0.8, color: '#8b5cf6' },
    { label: 'Cache', x: 0.68, y: 0.35, color: '#10b981' },
    { label: 'Database', x: 0.68, y: 0.65, color: '#f59e0b' },
    { label: 'Object Store', x: 0.84, y: 0.5, color: '#ef4444' },
  ];
  const edges = [[0,1],[1,2],[1,3],[2,4],[2,5],[3,5],[5,6],[4,7],[5,8],[7,8],[8,9],[6,8]];
  const packets = [];
  function spawnPacket() {
    const edge = edges[Math.floor(Math.random() * edges.length)];
    packets.push({ from: edge[0], to: edge[1], t: 0, speed: 0.003 + Math.random() * 0.004 });
  }
  setInterval(spawnPacket, 400);
  function draw() {
    ctx.clearRect(0, 0, w, h);
    edges.forEach(([a, b]) => {
      ctx.beginPath(); ctx.moveTo(nodes[a].x * w, nodes[a].y * h); ctx.lineTo(nodes[b].x * w, nodes[b].y * h);
      ctx.strokeStyle = 'rgba(255,255,255,0.06)'; ctx.lineWidth = 1; ctx.stroke();
    });
    for (let i = packets.length - 1; i >= 0; i--) {
      const pk = packets[i]; pk.t += pk.speed;
      if (pk.t >= 1) { packets.splice(i, 1); continue; }
      const na = nodes[pk.from], nb = nodes[pk.to];
      const px = (na.x + (nb.x - na.x) * pk.t) * w, py = (na.y + (nb.y - na.y) * pk.t) * h;
      ctx.beginPath(); ctx.arc(px, py, 3, 0, Math.PI * 2);
      ctx.fillStyle = nb.color; ctx.fill();
      ctx.shadowColor = nb.color; ctx.shadowBlur = 10; ctx.fill(); ctx.shadowBlur = 0;
    }
    nodes.forEach(n => {
      const nx = n.x * w, ny = n.y * h;
      ctx.beginPath(); ctx.roundRect(nx - 40, ny - 15, 80, 30, 6);
      ctx.fillStyle = 'rgba(10,10,15,0.8)'; ctx.fill();
      ctx.strokeStyle = n.color + '55'; ctx.lineWidth = 1; ctx.stroke();
      ctx.fillStyle = n.color; ctx.font = '10px Inter, sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText(n.label, nx, ny);
    });
    requestAnimationFrame(draw);
  }
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) draw();
}

document.addEventListener('DOMContentLoaded', () => { initTerminal(); initHeroCanvas(); initInfraCanvas(); });
</script>
</BaseLayout>
