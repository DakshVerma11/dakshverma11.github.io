---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---
<BaseLayout title="Resume - Daksh Verma" description="View and download Daksh Verma's resume" currentPath="/resume">

<div class="page-header"><div class="container">
  <p class="section-label">Resume</p>
  <h1 class="page-title">Resume</h1>
  <p class="page-desc">View inline or download a copy.</p>
</div></div>

<section class="section" style="padding-top:20px;">
<div class="container">
  <div class="resume-viewer reveal">
    <div class="resume-actions">
      <a href="https://drive.google.com/file/d/1OU6HPxYF0b6xVw8TG_PAMH5F1uYsrCQn/view" target="_blank" rel="noopener" class="btn btn-primary">Open in New Tab -></a>
      <a href="https://drive.google.com/uc?export=download&id=1OU6HPxYF0b6xVw8TG_PAMH5F1uYsrCQn" class="btn btn-ghost" download>Download PDF</a>
    </div>
    <iframe
      src="https://drive.google.com/file/d/1OU6HPxYF0b6xVw8TG_PAMH5F1uYsrCQn/preview"
      title="Daksh Verma Resume Preview"
      class="resume-frame"
      loading="lazy"
      allow="autoplay"
    ></iframe>

  </div>
</div>
</section>

</BaseLayout>
